{
  "name": "@competlab/sdk",
  "version": "4.0.0",
  "description": "TypeScript SDK for the CompetLab competitive intelligence API",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "openapi-ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsdown && node scripts/strip-dts-sourcemap-ref.mjs",
    "verify:generated": "npm run generate && git diff --exit-code -- src/generated",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "competlab",
    "competitive-intelligence",
    "ai-visibility",
    "competitor-analysis",
    "api-client",
    "mcp",
    "chatgpt",
    "claude",
    "gemini",
    "seo"
  ],
  "author": "CompetLab",
  "homepage": "https://competlab.com/developers/api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/competlab/competlab-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/competlab/competlab-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@hey-api/openapi-ts": "0.94.2",
    "tsdown": "0.21.4",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
